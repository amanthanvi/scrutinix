{
  "name": "scrutinix",
  "version": "3.0.0",
  "description": "FOSS multi-signal URL threat analyzer with streamed NDJSON results, batch scans, and local history.",
  "private": true,
  "license": "MIT",
  "homepage": "https://www.scrutinix.net",
  "repository": {
    "type": "git",
    "url": "https://github.com/amanthanvi/scrutinix.git"
  },
  "bugs": {
    "url": "https://github.com/amanthanvi/scrutinix/issues"
  },
  "keywords": [
    "security",
    "cybersecurity",
    "url-scanner",
    "phishing-detection",
    "threat-intelligence",
    "nextjs",
    "typescript"
  ],
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "onnxruntime-node": true
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest --config vitest.unit.config.ts",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "test:dom": "vitest --config vitest.dom.config.ts",
    "test:coverage": "vitest --config vitest.unit.config.ts --coverage --run",
    "test:e2e": "node ./scripts/run-e2e.mjs",
    "audit:ci": "node ./scripts/audit-gate.mjs",
    "lighthouse": "node ./scripts/run-lighthouse.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "idb": "^8.0.3",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tldts": "^7.4.11",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/eslint-plugin-next": "16.3.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.9.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-x": "^5.18.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.2.0",
    "msw": "^2.15.0",
    "postcss": "8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "minimatch@^3.1.0": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@^9.0.0": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@^10.0.0": {
      "brace-expansion": "5.0.9"
    },
    "postcss": "8.5.28",
    "sharp": "0.35.4",
    "ws": "8.21.1"
  }
}
