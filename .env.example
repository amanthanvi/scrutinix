# Copy this file to .env.local and add the providers you want enabled.
# Scrutinix degrades gracefully when optional third-party services are unset;
# empty values are treated as unset.

VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
# abuse.ch account key; used for both URLhaus and ThreatFox lookups.
URLHAUS_AUTH_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
OPENPHISH_FEED_URL=https://openphish.com/feed.txt
NEXT_PUBLIC_APP_URL=https://www.scrutinix.net
SPAMHAUS_DQS_KEY=

# --- Signed share links ------------------------------------------------------
# HMAC-SHA256 key the server uses to sign "Share" links (/?shared=...&sig=...).
# Only a link whose signature verifies is shown as a Scrutinix result and given
# a per-result preview image; unsigned, tampered, and expired links open a
# neutral "Check this shared link yourself" view. Leave it empty and sharing
# still works, but every shared link opens neutral.
#
# Requirements: at least 32 characters. A shorter value is ignored (with one
# logged warning that never contains the value), so sharing falls back to
# unsigned. Never reuse the e2e test key committed in scripts/run-e2e.mjs; it
# is public and is refused outside the test-fixture suite.
#
# Generate one (64 characters) with either of:
#   openssl rand -base64 48
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
#
# Set it in the Vercel Production environment ONLY, then redeploy (a variable
# applies only to deployments built after it changes). Anything holding this key
# can mint links production accepts as "Verified", and Vercel exposes variables
# scoped to Preview to unreviewed branches, so leave it empty here and in
# Preview/Development unless you are testing signing locally with a throwaway
# key of your own.
SHARE_SIGNING_SECRET=
# Rotation only: the key being retired. It verifies links but never signs them.
# Move the old SHARE_SIGNING_SECRET here, put the new key above, redeploy, and
# keep this for at least 72 hours (signed links expire after three days), then
# clear it. Same length and scoping rules as above.
SHARE_SIGNING_SECRET_PREVIOUS=
