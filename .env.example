# Copy this file to .env.local and add the providers you want enabled.
# Scrutinix degrades gracefully when optional third-party services are unset;
# empty values are treated as unset.

VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
# abuse.ch account key; used for both URLhaus and ThreatFox lookups.
URLHAUS_AUTH_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
OPENPHISH_FEED_URL=https://openphish.com/feed.txt
NEXT_PUBLIC_APP_URL=https://www.scrutinix.net
